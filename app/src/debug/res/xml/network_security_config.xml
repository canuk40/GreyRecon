<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only (app/src/debug is never merged into a release build): allows cleartext HTTP to the
  dev machine's own LAN IP so greyrecon-pkg's fetch/install-from-URL can be tested against a local
  test server without standing up TLS just for that. Real usage (release builds) gets the platform
  default: cleartext HTTP blocked everywhere, unchanged.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.3.155</domain>
    </domain-config>
</network-security-config>
